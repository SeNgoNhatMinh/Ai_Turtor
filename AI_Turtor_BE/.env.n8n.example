# Copy this file to .env.n8n if you want to override local n8n settings.
# Do not commit .env.n8n.

GENERIC_TIMEZONE=Asia/Bangkok
TZ=Asia/Bangkok

# Local n8n UI and webhook URLs
N8N_HOST=localhost
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/

# When Spring Boot runs on your Windows host / IntelliJ:
AI_TUTOR_API_BASE_URL=http://host.docker.internal:8085

# If Spring Boot is later dockerized in the same compose network, use:
# AI_TUTOR_API_BASE_URL=http://ai-tutor-api:8085