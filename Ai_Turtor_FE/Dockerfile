FROM node:22-alpine AS build

WORKDIR /app

# Stay on npm 10.x. The image prints a notice for npm 12, but npm 12 is a
# breaking release and is not required for this lockfile.
RUN npm install -g npm@10.9.8

ARG VITE_API_BASE_URL
ARG VITE_API_TIMEOUT_MS
ARG VITE_API_WITH_CREDENTIALS
ARG VITE_REALTIME_ENABLED
ARG VITE_CHAT_SOCKET_URL
ARG VITE_REALTIME_SOCKET_URL
ARG VITE_N8N_ENABLED
ARG VITE_N8N_STRICT
ARG VITE_N8N_BASE_URL
ARG VITE_N8N_WEBHOOK_MODE
ARG VITE_N8N_TIMEOUT_MS
ARG VITE_N8N_CHAT_TIMEOUT_MS
ARG VITE_N8N_QUIZ_TIMEOUT_MS
ARG VITE_N8N_QUIZ_ENABLED
ARG VITE_N8N_ASSIGNMENT_GRADING_ENABLED
ARG VITE_N8N_ASSIGNMENT_GRADING_TIMEOUT_MS
ARG VITE_N8N_TUTOR_V2_ENABLED
ARG VITE_N8N_TUTOR_V2_TIMEOUT_MS
ARG VITE_N8N_TUTOR_V2_FLOW_TIMEOUT_MS
ARG VITE_N8N_TUTOR_V2_APPROVAL_TIMEOUT_MS
ARG VITE_N8N_TUTOR_V2_EVALUATION_TIMEOUT_MS

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_API_TIMEOUT_MS=$VITE_API_TIMEOUT_MS \
    VITE_API_WITH_CREDENTIALS=$VITE_API_WITH_CREDENTIALS \
    VITE_REALTIME_ENABLED=$VITE_REALTIME_ENABLED \
    VITE_CHAT_SOCKET_URL=$VITE_CHAT_SOCKET_URL \
    VITE_REALTIME_SOCKET_URL=$VITE_REALTIME_SOCKET_URL \
    VITE_N8N_ENABLED=$VITE_N8N_ENABLED \
    VITE_N8N_STRICT=$VITE_N8N_STRICT \
    VITE_N8N_BASE_URL=$VITE_N8N_BASE_URL \
    VITE_N8N_WEBHOOK_MODE=$VITE_N8N_WEBHOOK_MODE \
    VITE_N8N_TIMEOUT_MS=$VITE_N8N_TIMEOUT_MS \
    VITE_N8N_CHAT_TIMEOUT_MS=$VITE_N8N_CHAT_TIMEOUT_MS \
    VITE_N8N_QUIZ_TIMEOUT_MS=$VITE_N8N_QUIZ_TIMEOUT_MS \
    VITE_N8N_QUIZ_ENABLED=$VITE_N8N_QUIZ_ENABLED \
    VITE_N8N_ASSIGNMENT_GRADING_ENABLED=$VITE_N8N_ASSIGNMENT_GRADING_ENABLED \
    VITE_N8N_ASSIGNMENT_GRADING_TIMEOUT_MS=$VITE_N8N_ASSIGNMENT_GRADING_TIMEOUT_MS \
    VITE_N8N_TUTOR_V2_ENABLED=$VITE_N8N_TUTOR_V2_ENABLED \
    VITE_N8N_TUTOR_V2_TIMEOUT_MS=$VITE_N8N_TUTOR_V2_TIMEOUT_MS \
    VITE_N8N_TUTOR_V2_FLOW_TIMEOUT_MS=$VITE_N8N_TUTOR_V2_FLOW_TIMEOUT_MS \
    VITE_N8N_TUTOR_V2_APPROVAL_TIMEOUT_MS=$VITE_N8N_TUTOR_V2_APPROVAL_TIMEOUT_MS \
    VITE_N8N_TUTOR_V2_EVALUATION_TIMEOUT_MS=$VITE_N8N_TUTOR_V2_EVALUATION_TIMEOUT_MS

COPY package.json package-lock.json .npmrc ./
RUN npm ci

COPY . .
RUN npm run build

FROM caddy:2-alpine

COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv

EXPOSE 3000

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
