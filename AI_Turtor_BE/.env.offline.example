# Offline MongoDB overrides. Copy to .env.offline (git-ignored) and set real passwords.
# Use together with .env.deploy:
#   docker compose -f docker-compose.deploy.yml -f docker-compose.offline.yml \
#     --env-file .env.deploy --env-file .env.offline up -d

MONGO_ROOT_USERNAME=mongo_root
MONGO_ROOT_PASSWORD=change-me-root
MONGO_APP_DB=tutor_db
MONGO_APP_USERNAME=tutor_app
MONGO_APP_PASSWORD=change-me-app
MONGO_OFFLINE_PORT=27017

# Backend connects through the Docker network alias "mongodb", never localhost.
SPRING_DATA_MONGODB_URI=mongodb://tutor_app:change-me-app@mongodb:27017/tutor_db?authSource=tutor_db

MONGO_BACKUP_DIR=./backup
