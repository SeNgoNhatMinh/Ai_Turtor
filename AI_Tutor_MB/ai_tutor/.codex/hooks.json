{
  "description": "AI Tutor Flutter project guardrails; review before trusting.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/runtime.mjs codex session",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/runtime.mjs codex pre",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/runtime.mjs codex post",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
