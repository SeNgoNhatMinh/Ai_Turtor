# =========================
# AI Tutor deploy env
# Copy this file to .env.deploy and edit values.
# =========================

# Backend
AI_TUTOR_API_PORT=8085
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000
STUDENT_DAILY_QUESTION_LIMIT=10
TUTOR_ANSWER_CACHE_ENABLED=true
TUTOR_ANSWER_CACHE_TTL_HOURS=168
TUTOR_ANSWER_CACHE_SEMANTIC_ENABLED=true
TUTOR_ANSWER_CACHE_SEMANTIC_MIN_SIMILARITY=0.90
TUTOR_ANSWER_CACHE_SEMANTIC_MIN_KEYWORD_OVERLAP=0.45
TUTOR_ANSWER_CACHE_SEMANTIC_MIN_SOURCE_OVERLAP=0.20
RAG_GENERATION_MAX_CONTEXT_CHARS=12000
RAG_QUERY_TRANSLATION_ENABLED=true
LLM_SKIP_DIACRITICS_FOR_ENGLISH_QUESTIONS=true

# Chat LLM provider chain: Groq -> NVIDIA -> OpenRouter -> free router -> Ollama.
LLM_PROVIDER_COOLDOWN_SECONDS=60
LLM_QUOTA_COOLDOWN_SECONDS=900
LLM_QUOTA_SOFT_COOLDOWN_SECONDS=120
LLM_PROVIDER_REORDER_ON_QUOTA=true
AI_INTENT_LLM_ENABLED=true
LLM_DAILY_QUOTA_COOLDOWN_SECONDS=86400
GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.6-27b,llama-3.3-70b-versatile,openai/gpt-oss-20b,llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=60
# NVIDIA hosted NIM trial. Use the nvapi- key from build.nvidia.com, not an NGC image-pull key.
NVIDIA_NIM_ENABLED=true
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODELS=nvidia/nemotron-3-super-120b-a12b
NVIDIA_NIM_TIMEOUT_SECONDS=90

# OpenRouter hosted fallbacks.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-your-primary-key-here
OPENROUTER_EMBEDDING_API_KEY=sk-or-your-embedding-key-here
OPENROUTER_ENABLED=true
OPENROUTER_MODEL=tencent/hy3:free
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=0
OPENROUTER_FALLBACK_ENABLED=true
OPENROUTER_FALLBACK_API_KEY=sk-or-your-fallback-key-here
OPENROUTER_FALLBACK_MODEL=openai/gpt-oss-120b:free
OPENROUTER_FALLBACK_TIMEOUT_SECONDS=60
OPENROUTER_FALLBACK_MAX_RETRIES=0
OPENROUTER_FREE_ROUTER_ENABLED=true
OPENROUTER_FREE_ROUTER_MODEL=openrouter/free

# RAG rerank (OpenRouter, optional). Falls back to ES order if quota fails.
OPENROUTER_RERANK_API_KEY=
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
RAG_RETRIEVAL_TOP_K=20
RAG_RERANK_TOP_K_AFTER=5

# Visual RAG (demo through OpenRouter; no local GPU required)
RAG_VISUAL_ENABLED=false
RAG_VISUAL_PROVIDER=openrouter
RAG_VISUAL_ELASTICSEARCH_INDEX=course_material_vectors_visual_nemotron_v1
RAG_VISUAL_MAX_PAGES_PER_MATERIAL=200
RAG_VISUAL_RETRIEVAL_TOP_K=4
RAG_VISUAL_RETRIEVAL_NUM_CANDIDATES=40
OPENROUTER_VISUAL_EMBEDDING_API_KEY=
OPENROUTER_VISUAL_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
TUTOR_ANSWER_CACHE_SEMANTIC_EARLY_MIN_SIMILARITY=0.92
TUTOR_ANSWER_CACHE_SEMANTIC_EARLY_MIN_KEYWORD_OVERLAP=0.50
RAG_APPROVED_KNOWLEDGE_MAX_CHUNKS=2
RAG_APPROVED_KNOWLEDGE_MIN_SCORE=0.60
RAG_APPROVED_KNOWLEDGE_STRONG_SCORE=0.82
RAG_APPROVED_KNOWLEDGE_MIN_KEYWORD_OVERLAP=0.12

# MongoDB
# Production/Atlas connection. Keep the real credential only in .env.deploy.
SPRING_DATA_MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/tutor_db?retryWrites=true&w=majority
# Host directory used by the one-shot mongo-backup/mongo-restore profiles.
MONGO_BACKUP_DIR=./backup
# Used by mongo-backup. For local Docker Mongo, enable the local-db profile too.
MONGO_BACKUP_SOURCE_URI=mongodb://mongodb:27017/tutor_db
MONGO_PORT=27017

# Elasticsearch
ELASTICSEARCH_PORT_PUBLIC=9200
ELASTICSEARCH_INDEX=course_material_vectors
ES_JAVA_OPTS=-Xms512m -Xmx512m

# Ollama embedding + local chat fallback
# If Ollama is on the same compose network, keep http://ollama:11434
# If Ollama is hosted elsewhere, set the public/internal URL here.
# Backend auto-falls back to 127.0.0.1 when host.docker.internal is unreachable.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_CHAT_ENABLED=true
OLLAMA_CHAT_MODEL=gemma3:4b
OLLAMA_CHAT_TIMEOUT_SECONDS=90
OLLAMA_CHAT_TEMPERATURE=0.2
OLLAMA_CHAT_NUM_PREDICT=512
OLLAMA_CHAT_NUM_CTX=4096
OLLAMA_CHAT_MAX_RETRIES=0
LLM_CLOUD_FAILOVER_TIMEOUT_SECONDS=20
LLM_SKIP_DIACRITICS_FOR_OLLAMA=true
RAG_QUERY_TRANSLATION_SKIP_WHEN_OLLAMA_ONLY=true
RAG_GENERATION_OLLAMA_MAX_CONTEXT_CHARS=6000
NVIDIA_EMBEDDING_API_KEY=
NVIDIA_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBEDDING_TIMEOUT_SECONDS=30
NVIDIA_EMBEDDING_MAX_RETRIES=3
# Pair this provider with a dedicated index; never mix vectors from different models.
# RAG_EMBEDDING_PROVIDER=nvidia
# ELASTICSEARCH_INDEX=course_material_vectors_nemotron3_2048
OLLAMA_PORT_PUBLIC=11434

# n8n
N8N_PORT_PUBLIC=5678
GENERIC_TIMEZONE=Asia/Bangkok
TZ=Asia/Bangkok
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false

# Initial admin account
ADMIN_ACCOUNT_EMAIL=admin@system.local
ADMIN_ACCOUNT_PASSWORD=admin123
ADMIN_ACCOUNT_FULL_NAME=System Admin

# Security
JWT_SECRET=change-this-to-a-long-random-secret-for-production
SWAGGER_PASSWORD=change-this-swagger-password
